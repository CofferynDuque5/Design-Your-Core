{
  "name": "@dyc/api-client",
  "private": true,
  "version": "0.1.0",
  "description": "Cliente tipado de la API de Design Your Core para la web y la app móvil",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dyc/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
