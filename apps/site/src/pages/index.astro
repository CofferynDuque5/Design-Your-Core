---
import { ArrowRight, Check, Download, Laptop, Smartphone } from '@lucide/astro';
import PillarIcon from '../components/PillarIcon.astro';
import Shot from '../components/Shot.astro';
import { appLink } from '../config';
import { FAQ, FEATURES, PILLARS, PLATFORMS, PRINCIPLES, TOOL_COUNT, TOOLS } from '../content';
import Base from '../layouts/Base.astro';

const STATS = [
  { value: String(TOOL_COUNT), label: 'herramientas en un panel' },
  { value: '6', label: 'pilares de bienestar' },
  { value: '1 min', label: 'para el check-in del día' },
  { value: '6', label: 'plataformas, una cuenta' },
];
---

<Base
  title="Design Your Core"
  description="Tu bienestar, tus estudios y tu día en un solo panel: seis pilares, hábitos, cursos con horario automático, notas con fórmulas, agenda, finanzas y un asistente. En el navegador, el teléfono y la computadora."
>
  <section class="hero">
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="eyebrow hero__eyebrow"><span class="dot" aria-hidden="true"></span> Ahora con app para teléfono y computadora</p>
        <h1 class="display">Diseña tu forma de <em>estar bien</em>.</h1>
        <p class="lead">
          Tu bienestar, tus estudios y tu día en un solo panel. Seis pilares, hábitos pequeños, cursos que se ordenan solos y un asistente que te ayuda a organizarlo todo.
        </p>
        <div class="hero__actions">
          <a class="btn btn--lg" href={appLink('/registro')}>Crear mi cuenta <ArrowRight size={18} aria-hidden="true" /></a>
          <a class="btn btn--secondary btn--lg" href="/descargar"><Download size={18} aria-hidden="true" /> Descargar la app</a>
        </div>
        <ul class="hero__platforms" aria-label="Funciona en">
          {PLATFORMS.map((p) => <li>{p}</li>)}
        </ul>
      </div>
      <div class="hero__visual">
        <Shot name="hoy" alt="El panel de Design Your Core en la computadora: pantalla Hoy" eager class="hero__desk" />
        <Shot name="hoy" kind="phone" alt="Design Your Core en el teléfono: pantalla Hoy" eager class="hero__phone" />
      </div>
    </div>
  </section>

  <section class="stats" aria-label="En números">
    <div class="container">
      <ul class="stats__list">
        {
          STATS.map((s) => (
            <li>
              <span class="stats__value">{s.value}</span>
              <span class="stats__label">{s.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="funciones" class="section">
    <div class="container">
      <div class="section__intro">
        <p class="eyebrow">Funciones</p>
        <h2>Todo lo que haces en el día, conectado.</h2>
        <p class="lead">Lo que anotas en un sitio aparece donde lo necesitas: tus clases en el calendario, tus cursos en el horario y tu semana en tu progreso.</p>
      </div>
      <div class="features">
        {
          FEATURES.map((f, i) => (
            <article class="feature" id={`f-${f.id}`}>
              <div class="feature__copy">
                <span class="feature__num" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <p class="eyebrow">{f.kicker}</p>
                <h3>{f.title}</h3>
                <p class="muted">{f.body}</p>
                <ul class="feature__points">
                  {f.points.map((pt) => (
                    <li>
                      <Check size={16} aria-hidden="true" /> {pt}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="feature__media">
                <Shot name={f.shot} alt={f.alt} />
                <Shot name={f.shot} kind="phone" alt={`${f.alt}, en el teléfono`} class="feature__phone" />
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="herramientas" class="section section--tinted">
    <div class="container">
      <div class="section__intro">
        <p class="eyebrow">Herramientas</p>
        <h2>{TOOL_COUNT} herramientas, un solo lugar.</h2>
        <p class="lead">Todo lo que antes estaba en apps separadas. Cada una con «Sugerencias» para empezar rápido.</p>
      </div>
      <div class="tools">
        {
          TOOLS.map((g) => (
            <section class="tools__group" aria-labelledby={`g-${g.id}`}>
              <h3 id={`g-${g.id}`}>{g.label}</h3>
              <ul>
                {g.tools.map((t) => (
                  <li>
                    <strong>{t.label}</strong>
                    <span class="muted small">{t.description}</span>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
      <div class="gallery" aria-label="Más pantallas">
        <Shot name="metas" alt="Pantalla Metas con el avance de cada meta" />
        <Shot name="emprendimientos" alt="Pantalla Emprendimientos con tres proyectos" />
        <Shot name="roadmaps" alt="Pantalla Roadmaps con los pasos de una ruta de estudio" />
        <Shot name="calendario" alt="Pantalla Calendario del mes" />
      </div>
    </div>
  </section>

  <section id="pilares" class="section">
    <div class="container">
      <div class="section__intro">
        <p class="eyebrow">Los seis pilares</p>
        <h2>Lo que te sostiene, a la vista.</h2>
        <p class="lead">No se trata de optimizar cada minuto. Se trata de ver el conjunto y elegir el siguiente paso pequeño.</p>
      </div>
      <ul class="pillars">
        {
          PILLARS.map((p) => (
            <li class="pillar" data-pillar={p.id}>
              <span class="pillar__icon">
                <PillarIcon pillar={p.id} />
              </span>
              <h3>{p.name}</h3>
              <p class="muted">{p.description}</p>
              <p class="pillar__example">
                <span class="eyebrow">Un reto para empezar</span>
                <span>{p.example.title}</span>
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="descargar" class="section section--tinted">
    <div class="container download">
      <div class="download__copy">
        <p class="eyebrow">Descargar</p>
        <h2>En tu teléfono y en tu computadora.</h2>
        <p class="lead">Una sola cuenta: lo que anotas en el teléfono aparece en la computadora al instante.</p>
        <div class="download__cards">
          <a class="download__card" href={appLink('/?instalar')}>
            <Smartphone size={28} aria-hidden="true" />
            <strong>Teléfono</strong>
            <span class="muted small">Android y iPhone: se instala desde el navegador, con su icono.</span>
          </a>
          <a class="download__card" href="/descargar">
            <Laptop size={28} aria-hidden="true" />
            <strong>Computadora</strong>
            <span class="muted small">Windows, Mac y Linux, en su propia ventana.</span>
          </a>
        </div>
        <a class="btn btn--lg" href="/descargar"><Download size={18} aria-hidden="true" /> Ver todas las descargas</a>
      </div>
      <div class="download__visual">
        <Shot name="enfoque" kind="phone" alt="Enfoque en el teléfono: temporizador de 25 minutos" />
        <Shot name="habitos" kind="phone" alt="Hábitos en el teléfono: los días cumplidos de cada hábito" />
      </div>
    </div>
  </section>

  <section id="principios" class="section">
    <div class="container principles">
      <blockquote class="quote">
        <p>«Lo importante no es hacerlo todo, sino hacer hoy un poco de lo que de verdad te importa.»</p>
      </blockquote>
      <ul class="principles__list">
        {
          PRINCIPLES.map((p) => (
            <li>
              <h3>{p.title}</h3>
              <p class="muted">{p.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="preguntas" class="section section--tinted">
    <div class="container faq">
      <div class="section__intro">
        <p class="eyebrow">Preguntas</p>
        <h2>Lo que suelen preguntarnos.</h2>
      </div>
      <div class="faq__list">
        {
          FAQ.map((f) => (
            <details class="faq__item">
              <summary>{f.q}</summary>
              <p class="muted">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section cta">
    <div class="container cta__inner">
      <h2>Empieza con un minuto.</h2>
      <p class="lead">Crea tu cuenta, elige tus pilares y haz tu primer check-in. Lo demás llega poco a poco.</p>
      <div class="hero__actions">
        <a class="btn btn--light btn--lg" href={appLink('/registro')}>Crear mi cuenta</a>
        <a class="btn btn--outline-light btn--lg" href={appLink('/entrar')}>Ya tengo cuenta</a>
      </div>
    </div>
  </section>
</Base>
