---
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada" description="Esta página no existe. Vuelve al inicio para conocer los seis pilares de Design Your Core.">
  <section class="container prose not-found">
    <p class="eyebrow">Error 404</p>
    <h1>Esta página no existe</h1>
    <p class="lead">Puede que el enlace esté mal o que la página se haya movido.</p>
    <p><a class="btn" href="/">Volver al inicio</a></p>
  </section>
</Base>
