---
import { appLink, AUTHORS, CONTACT_EMAIL, PORTFOLIO_URL } from '../config';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <Logo />
      <p class="muted small">Tu bienestar, tus estudios y tu día, en un solo panel.</p>
    </div>
    <nav aria-label="Producto" class="site-footer__nav">
      <span class="site-footer__title">Producto</span>
      <a href="/#funciones">Funciones</a>
      <a href="/#herramientas">Herramientas</a>
      <a href="/#pilares">Pilares</a>
      <a href="/descargar">Descargar</a>
    </nav>
    <nav aria-label="Cuenta" class="site-footer__nav">
      <span class="site-footer__title">Cuenta</span>
      <a href={appLink('/registro')}>Crear cuenta</a>
      <a href={appLink('/entrar')}>Entrar</a>
      <a href="/#preguntas">Preguntas</a>
    </nav>
    <nav aria-label="Legal" class="site-footer__nav">
      <span class="site-footer__title">Legal y contacto</span>
      <a href="/privacidad">Privacidad</a>
      <a href="/condiciones">Condiciones</a>
      <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </nav>
  </div>
  <div class="container site-footer__authors">
    <span class="site-footer__title">Creado por</span>
    <ul>
      {
        AUTHORS.map((a) => (
          <li>
            <strong>{a.name}</strong>
            <span class="muted small">{a.role}</span>
          </li>
        ))
      }
    </ul>
    <a class="site-footer__portfolio" href={PORTFOLIO_URL} rel="noopener">
      Ver el portafolio de Valeryn: cofferyncode.nvcorx.com
    </a>
  </div>
  <div class="container">
    <p class="muted small site-footer__legal">© {year} Design Your Core. Hecho en Venezuela.</p>
  </div>
</footer>
