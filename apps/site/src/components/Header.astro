---
import { appLink } from '../config';
import Logo from './Logo.astro';
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__home" aria-label="Design Your Core, inicio"><Logo /></a>
    <nav aria-label="Principal" class="site-nav">
      <a href="/#pilares">Pilares</a>
      <a href="/#como-funciona">Cómo funciona</a>
      <a href="/#principios">Principios</a>
    </nav>
    <div class="site-header__actions">
      <a class="btn btn--ghost btn--sm" href={appLink('/entrar')}>Entrar</a>
      <a class="btn btn--sm" href={appLink('/registro')}>Crear cuenta</a>
    </div>
  </div>
</header>
