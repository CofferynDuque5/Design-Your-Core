# ════════════════════════════════════════════════════════════════
#  CONFIGURACIÓN DE LA API DE DESIGN YOUR CORE
#  Copia este archivo como core-config.env (NO lo subas a git).
#  En cPanel es el único lugar donde se configura: tiene prioridad
#  sobre las "Environment variables" del panel.
# ════════════════════════════════════════════════════════════════

NODE_ENV=production

# 1) Cadena de conexión de Neon (la que NO tiene "-pooler").
DATABASE_URL=postgresql://USUARIO:CLAVE@ep-xxxx.neon.tech/neondb?sslmode=require

# 2) Secreto de las sesiones: 64+ caracteres aleatorios. Genera uno con:
#    node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#    Cambiarlo cierra la sesión de todos los usuarios.
JWT_SECRET=

# 3) Dominios. Deben coincidir EXACTAMENTE con los reales.
#    CLIENT_ORIGIN: dónde se abre la app web (varios separados por comas).
#    PUBLIC_URL: la URL de ESTA API (se usa en los enlaces de recuperación).
#    La app publicada hoy llama a https://designyourcorebackend.nvcorx.com, así que
#    esa es la API. La configuración anterior decía api.desingyourcore.nvcorx.com
#    ("desing"): si ese dominio no existe, los enlaces de recuperación no abren.
#    Verifica en cPanel en qué dominio se abre la app antes de desplegar.
CLIENT_ORIGIN=https://desingyourcore.nvcorx.com
PUBLIC_URL=https://designyourcorebackend.nvcorx.com
# Cualquier subdominio de estos dominios también puede usar la API.
ALLOWED_ROOT_DOMAINS=nvcorx.com

# 4) Correo (invitación de pareja y recuperación de contraseña).
#    Si SMTP_PASS queda vacío la app funciona igual; los enlaces se registran en el log.
SMTP_HOST=mail.desingyourcore.nvcorx.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@desingyourcore.nvcorx.com
SMTP_PASS=
SMTP_FROM=Design Your Core <no-reply@desingyourcore.nvcorx.com>
