# Apache / LiteSpeed (cPanel): las rutas de la app (/progreso, /retos…) sirven index.html.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# El service worker y el HTML nunca se cachean: así las actualizaciones llegan.
<FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
  Header set Cache-Control "no-cache"
</FilesMatch>
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
